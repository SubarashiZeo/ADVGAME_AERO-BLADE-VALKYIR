                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!That is because this\nsuit was designed with\nan ability",
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!which converts\nweaponry from\n\\007\\1!S3!specialized drones\\007\\2!S2!.   ",
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!One last thing.",
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!This feature is far\nmore experimental,",
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!but the suit can\n\\007\\1!S3!upgrade\\007\\2!S2! your current\nweapons",
                      "\\007\\2!S2!!F:8ed435d9-51cb-44e7-8b0d-ca85e63ca427!if you collect a weapon\nof the \\007\\1!S3!same type\\007\\2!S2! again."
                    ],
                    "__section": "text",
                    "avatarId": "",
                    "minHeight": 5,
                    "maxHeight": 5,
