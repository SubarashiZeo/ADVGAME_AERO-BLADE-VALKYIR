    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "__presetId": "b79590e7-1578-4234-815e-68d10b0ad197",
        "text": [
          "That is\nbecause this\nsuit was\ndesigned to\nconvert the",
          "weaponry from\nspecialized\ndrones."
        ],
        "__section": "text",
        "avatarId": "c83be857-1957-4743-8b93-86ffd0957056",
        "minHeight": 5,
        "maxHeight": 7,
        "textX": 4,
